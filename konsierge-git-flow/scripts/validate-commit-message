#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'commit-msg: %s\n' "$1" >&2
  exit 1
}

message_file=${1:-}
[[ -n "$message_file" && -f "$message_file" ]] || fail "expected a commit message file"

branch=${KONSIERGE_BRANCH_OVERRIDE:-$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)}
[[ -n "$branch" ]] || fail "detached HEAD is not allowed for commits"

subject=$(sed -n '1p' "$message_file")
ticket_branch_pattern='^KON-([0-9]+)(-[a-z0-9]+(-[a-z0-9]+)*)?$'
worktree_branch_pattern='^KON-[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'
conventional_subject_pattern='^[a-z][a-z0-9-]*(\([a-z0-9][a-z0-9._/-]*\))?!?:[[:space:]]+[^[:space:]].*$'

is_konsierge_repository=false
if [[ "$(git config --bool --get konsierge.commitPolicy 2>/dev/null || true)" == true ]]; then
  is_konsierge_repository=true
fi

while IFS= read -r remote_name; do
  while IFS= read -r remote_url; do
    remote_host=$(printf '%s\n' "$remote_url" | sed -nE \
      -e 's#^[a-z][a-z0-9+.-]*://([^/@]+@)?([^/:]+).*#\2#p' \
      -e 's#^([^@]+@)?([^/:]+):.*#\2#p')
    if [[ "$remote_host" == gitlab.konsierge.com ]]; then
      is_konsierge_repository=true
      break 2
    fi
  done < <(git remote get-url --all "$remote_name" 2>/dev/null || true)
done < <(git remote 2>/dev/null || true)

merge_in_progress=false
revert_in_progress=false
git rev-parse --verify --quiet MERGE_HEAD >/dev/null 2>&1 && merge_in_progress=true
git rev-parse --verify --quiet REVERT_HEAD >/dev/null 2>&1 && revert_in_progress=true

if ! $is_konsierge_repository; then
  if $merge_in_progress && [[ "$subject" == Merge\ * ]]; then
    exit 0
  fi
  if $revert_in_progress && [[ "$subject" == Revert\ \"* ]]; then
    exit 0
  fi

  [[ "$subject" =~ $conventional_subject_pattern ]] ||
    fail "non-Konsierge repositories require a Conventional Commit subject"
  exit 0
fi

is_linked_worktree=false
git_dir=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null || true)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [[ -n "$git_dir" && -n "$common_dir" && "$git_dir" != "$common_dir" ]]; then
  is_linked_worktree=true
fi

if $is_linked_worktree && [[ "$branch" =~ ^(dev|master|KON-[0-9]+(-dev)?)$ ]]; then
  fail "persistent task and delivery branches belong only in the main checkout"
fi

if $merge_in_progress; then
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  exec python3 "$script_dir/delivery-policy" check-merge "$branch" "$message_file"
fi

[[ "$branch" != dev && "$branch" != master ]] || fail "ordinary commits directly on $branch are not allowed"
[[ "$branch" =~ $ticket_branch_pattern ]] || fail "branch must be KON-<number> or KON-<number>-<description>"
ticket="KON-${BASH_REMATCH[1]}"
if $is_linked_worktree; then
  [[ "$branch" =~ $worktree_branch_pattern ]] || fail "linked worktrees require KON-<number>-<description> branch names"
fi

[[ "$subject" =~ ^${ticket}:[[:space:]]+[^[:space:]].*$ ]] ||
  fail "commit subject must start with '${ticket}: '"
