#!/bin/sh
set -eu

config_path=${KONSIERGE_PRE_COMMIT_CONFIG:-"$HOME/.codex/skills/konsierge-git-flow/hooks/pre-commit-config.yaml"}
hook_name=$(basename "$0")

if [ "$hook_name" = commit-msg ]; then
  if ! command -v pre-commit >/dev/null 2>&1; then
    echo "commit-msg: pre-commit is not installed or not present in PATH" >&2
    exit 1
  fi

  if [ ! -f "$config_path" ]; then
    echo "commit-msg: global pre-commit config is missing: $config_path" >&2
    exit 1
  fi

  pre-commit run \
    --config "$config_path" \
    --hook-stage commit-msg \
    --commit-msg-filename "$1" || exit $?
fi

if [ "$hook_name" = pre-push ]; then
  skill_dir=${KONSIERGE_GIT_FLOW_SKILL_DIR:-"$HOME/.codex/skills/konsierge-git-flow"}
  input_file=$(mktemp "${TMPDIR:-/tmp}/konsierge-pre-push.XXXXXX")
  trap 'rm -f "$input_file"' EXIT
  trap 'exit 1' HUP INT TERM
  cat > "$input_file"
  python3 "$skill_dir/scripts/delivery-policy" check-push "$@" < "$input_file"
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
  repository_hook="$common_dir/hooks/pre-push"
  if [ -x "$repository_hook" ]; then
    "$repository_hook" "$@" < "$input_file"
  fi
  exit 0
fi

common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
repository_hook="$common_dir/hooks/$hook_name"

if [ -n "$common_dir" ] && [ -x "$repository_hook" ]; then
  exec "$repository_hook" "$@"
fi

exit 0
